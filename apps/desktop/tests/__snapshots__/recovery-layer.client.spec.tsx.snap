          class="_step_626cfd _complete_626cfd"
        >
          <span
            aria-hidden="true"
            class="_dot_626cfd"
          />
          <span
            class="_stepLabel_626cfd"
          >
            桌面宿主
          </span>
          <span
            class="_stepMeta_626cfd"
          >
            verified
          </span>
        </li>
        <li
          class="_step_626cfd _failed_626cfd"
        >
          <span
            aria-hidden="true"
            class="_dot_626cfd"
          />
          <span
            class="_stepLabel_626cfd"
          >
            Utility Host
          </span>
          <span
            class="_stepMeta_626cfd"
          >
            gen 4
          </span>
        </li>
        <li
          class="_step_626cfd _pending_626cfd"
        >
          <span
            aria-hidden="true"
            class="_dot_626cfd"
          />
          <span
            class="_stepLabel_626cfd"
          >
            安全数据通道
          </span>
          <span
            class="_stepMeta_626cfd"
          >
            circuit_open
          </span>
        </li>
        <li
          class="_step_626cfd _pending_626cfd"
        >
          <span
            aria-hidden="true"
            class="_dot_626cfd"
          />
          <span
            class="_stepLabel_626cfd"
          >
            产品界面
          </span>
          <span
            class="_stepMeta_626cfd"
          >
            waiting
          </span>
        </li>
      </ol>
      <p
        class="_detail_626cfd"
      >
        HOST_RESTART_BUDGET_EXHAUSTED: 自动恢复已暂停。
      </p>
      <div
        class="_actions_626cfd"
      >
        <button
          class="_retry_626cfd"
          type="button"
